diff --git a/packages/local/src/responsesSocket.ts b/packages/local/src/responsesSocket.ts
new file mode 100644
index 0000000..eaf3b53
--- /dev/null
+++ b/packages/local/src/responsesSocket.ts
@@ -0,0 +1,38 @@
+import { ChatGPTError } from "./errors.js";
+
+const responsesSocketUrl = "wss://api.openai.com/v1/responses";
+
+// Node's WebSocket accepts handshake headers; the DOM constructor type does not declare them.
+type HeaderWebSocket = new (url: string, init: { headers: Record<string, string> }) => WebSocket;
+
+/** Opens a Responses WebSocket authorized with `accessToken` and resolves once it is open. */
+export function openResponsesSocket(accessToken: string, signal: AbortSignal): Promise<WebSocket> {
+  signal.throwIfAborted();
+  const socket = new (WebSocket as unknown as HeaderWebSocket)(responsesSocketUrl, {
+    headers: { authorization: `Bearer ${accessToken}` },
+  });
+  return new Promise((resolve, reject) => {
+    const cleanup = () => {
+      socket.removeEventListener("open", opened);
+      socket.removeEventListener("error", failed);
+      socket.removeEventListener("close", failed);
+      signal.removeEventListener("abort", failed);
+    };
+    const opened = () => {
+      cleanup();
+      resolve(socket);
+    };
+    // Handshake failures carry no safe detail; the HTTP status is not exposed to WebSocket clients.
+    function failed() {
+      cleanup();
+      socket.close();
+      reject(signal.aborted
+        ? new ChatGPTError("cancelled", "The request was cancelled.")
+        : new ChatGPTError("socket_failed", "Could not open the Responses connection.", true));
+    }
+    socket.addEventListener("open", opened);
+    socket.addEventListener("error", failed);
+    socket.addEventListener("close", failed);
+    signal.addEventListener("abort", failed);
+  });
+}
