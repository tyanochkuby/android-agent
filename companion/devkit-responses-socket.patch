+test('a Responses socket opens with refreshed credentials and closes on disconnect', async (t) => {
+  const { client } = await fixture(t);
+  const calls = mockProvider(t, {
+    token: () => Response.json(tokenResponse()),
+    revoke: () => new Response(null, { status: 200 }),
+  });
+  const opened = [];
+  class FakeSocket extends EventTarget {
+    constructor(url, init) {
+      super();
+      opened.push({ url, authorization: init.headers.authorization });
+      this.readyState = 0;
+      queueMicrotask(() => { this.readyState = 1; this.dispatchEvent(new Event('open')); });
+    }
+    close() {
+      if (this.readyState === 3) return;
+      this.readyState = 3;
+      this.dispatchEvent(new Event('close'));
+    }
+  }
+  t.mock.property(globalThis, 'WebSocket', FakeSocket);
+  const socket = await client.openResponsesSocket();
+  assert.equal(socket.readyState, 1);
+  assert.deepEqual(opened, [{ url: 'wss://api.openai.com/v1/responses', authorization: 'Bearer successor-test-access' }]);
+  assert.equal(calls.token, 1);
+  await client.disconnect();
+  assert.equal(socket.readyState, 3);
+});
+
+test('a failed Responses socket handshake reports no credentials', async (t) => {
+  const { client } = await fixture(t);
+  mockProvider(t, { token: () => Response.json(tokenResponse()) });
+  class RefusedSocket extends EventTarget {
+    constructor() { super(); queueMicrotask(() => this.dispatchEvent(new Event('error'))); }
+    close() {}
+  }
+  t.mock.property(globalThis, 'WebSocket', RefusedSocket);
+  await assert.rejects(client.openResponsesSocket(), (error) => {
+    assert.equal(error.code, 'socket_failed');
+    assert.doesNotMatch(JSON.stringify(error), /test-access/);
+    return true;
+  });
+});
